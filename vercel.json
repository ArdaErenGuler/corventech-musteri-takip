{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/(includes|migrations|tests|api)/.*", "status": 404 },
    { "src": "/.*\\.(sql|md|lock|json\\.example)$", "status": 404 },
    { "src": "/(\\.git.*|\\.claude.*|\\.htaccess|\\.vercelignore|vercel\\.json)", "status": 404 },

    { "src": "/assets/(.*)", "dest": "/assets/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/manifest\\.json", "dest": "/manifest.json" },
    { "src": "/sw\\.js", "dest": "/sw.js", "headers": { "Cache-Control": "no-cache", "Service-Worker-Allowed": "/" } },
    { "src": "/offline\\.html", "dest": "/offline.html" },

    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
